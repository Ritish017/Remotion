# ==============================================================================
# Catalyst Content OS - Environment Configuration Example
# Copy this file to .env and configure your production API credentials.
# Never commit real API secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Director & Orchestration (Anthropic Claude API)
# ------------------------------------------------------------------------------
# Required for Claude Content Director, Storyboard Director, & Production Assistant
# Supported models: claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 2. Database & State Storage (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 3. Audio & Narration Providers (Optional - falls back to Local Synthesizer)
# ------------------------------------------------------------------------------
# ElevenLabs API for realistic voiceover with word-timestamp synchronization
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# OpenAI TTS (Alternative provider)
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 4. Cloud Rendering & Video Storage (AWS S3 & Remotion Lambda)
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_VIDEO_BUCKET=catalyst-videos-759433041913

# Remotion Lambda Configuration (Required for cloud rendering)
REMOTION_LAMBDA_FUNCTION_NAME=
REMOTION_SERVE_URL=
REMOTION_AWS_REGION=us-east-1

# ------------------------------------------------------------------------------
# 5. Application Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CATALYST_URL=/api/catalyst
NODE_ENV=production
