# ==============================================================================
# Catalyst Content OS - Production Environment Configuration Template
# Copy this file to .env and provide your production credentials.
# ==============================================================================

# Environment Mode: development | preview | production
APP_ENV=production
NODE_ENV=production

# Local-First Architecture Modes (Defaults for Local Production Mode)
CATALYST_STORAGE_MODE=local
CATALYST_DATABASE_MODE=sqlite
CATALYST_RENDER_MODE=local
CATALYST_STORAGE_PATH=./storage

# AI: Primary Creative Intelligence (Anthropic Claude)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_MODEL_PRIMARY=claude-3-5-sonnet-latest
ANTHROPIC_MODEL_FAST=claude-3-5-haiku-latest
ALLOW_DEMO_FALLBACK=false

# Local Rendering Engine
REMOTION_CONCURRENCY=4

# Audio: Production Narration & Transcription (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL_PRIMARY=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_TRANSCRIPTION_MODEL=whisper-1
NARRATION_MODE=production

# Research: Web Extraction (Firecrawl)
FIRECRAWL_API_KEY=

# Research: Structured Web Data (Apify)
APIFY_API_TOKEN=

# Presenter: Optional Avatar Video (HeyGen)
HEYGEN_API_KEY=
HEYGEN_TEMPLATE_ID=

# Voice Interface: Optional Voice Assistant (Vapi)
VAPI_API_KEY=

# Automation: Optional Workflow Engine (n8n)
N8N_API_KEY=
N8N_BASE_URL=

# Email & Notifications (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_DEFAULT_RECIPIENT=

# Database (Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Storage & Lambda Rendering (AWS)
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_VIDEO_BUCKET=catalyst-videos-759433041913
REMOTION_LAMBDA_FUNCTION_NAME=
REMOTION_SERVE_URL=
REMOTION_AWS_REGION=us-east-1

# Application
NEXT_PUBLIC_CATALYST_URL=/api/catalyst
